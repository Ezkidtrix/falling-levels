{
	"geode": "5.8.2",
	"gd": {
		"win": "2.2081",
		"mac": "2.2081"
	},
	"id": "ezkidtrix.falling-levels",
	"name": "Falling Levels",
	"version": "v1.0.0",
	"developer": "Ezkidtrix",
	"description": "",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Enabled",
			"default": true
		},
		"fall-speed": {
			"type": "float",
			"name": "Fall Speed",
			"description": "Changes how fast objects should fall down.",
			"default": 0.5,
			"min": 0.1,
			"max": 3.0,
			"enable-if": "enabled"
		},
		"fall-offset": {
			"type": "float",
			"name": "Fall Offset",
			"description": "Changes how far away objects should start falling down.",
			"default": 100.0,
			"min": 0.0,
			"max": 500.0,
			"enable-if": "enabled"
		}
	}
}
